{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "portafolio-sol-andriani.vercel.app" }
      ],
      "destination": "https://www.solandriani.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/imagenes/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
